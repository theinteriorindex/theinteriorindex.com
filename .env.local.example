# Copy this file to .env.local for local development.
# Add the same values in Vercel → Project Settings → Environment Variables for production.

# Server-only — powers the AI chat concierge (app/api/chat/route.ts).
# Never expose this to the browser.
ANTHROPIC_API_KEY=

# Public — safe to expose in the browser. Access is restricted by Postgres
# Row Level Security (only is_active = true rows are ever readable).
NEXT_PUBLIC_SUPABASE_URL=https://khtustdchmvurrsmcdbb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — powers the "email me this list" popup on the results page
# (app/api/send-list/route.ts). Get a free key at https://resend.com.
RESEND_API_KEY=

# Optional — the From address for those emails, e.g.
# "The Interior Index <hello@theinteriorindex.com>". Requires verifying
# theinteriorindex.com as a sending domain in Resend first. Until then this
# falls back to Resend's shared test address, which only delivers to the
# email you signed up to Resend with — fine for testing, not for real users.
RESEND_FROM_EMAIL=
